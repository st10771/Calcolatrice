<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0AA1AF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Immagine spostata in alto -->
    <ImageView
        android:id="@+id/imgPortrait"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginBottom="12dp"
        android:src="@drawable/olimpia_coppa"
        android:scaleType="fitCenter"
        tools:srcCompat="@drawable/olimpia_coppa" />

    <!-- Display sotto l'immagine -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp"
        android:background="#061240"
        android:gravity="center_vertical|end"
        android:padding="16dp"
        android:text="0"
        android:textColor="#EBD9D9"
        android:textSize="44sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Tastiera -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7.3"
        android:background="#051E5D"
        android:padding="8dp"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/t7" android:text="7" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t8" android:text="8" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t9" android:text="9" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/divisione" android:text="÷" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>

        <Button android:id="@+id/t4" android:text="4" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t5" android:text="5" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t6" android:text="6" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/moltiplicazione" android:text="×" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>

        <Button android:id="@+id/t1" android:text="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t2" android:text="2" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/t3" android:text="3" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/meno" android:text="-" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>

        <Button android:id="@+id/t0" android:text="0" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/punto" android:text="." android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/uguale" android:text="=" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>
        <Button android:id="@+id/piu" android:text="+" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="2dp"/>

        <Button
            android:id="@+id/cancella"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnSpan="4"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="2dp"
            android:text="C" />
    </GridLayout>

</LinearLayout>
